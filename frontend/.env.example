# API Configuration
# If unset, the browser derives the backend host from the current page and
# uses the default development API port 8000.
# VITE_API_BASE_URL=http://localhost:8000
VITE_API_PORT=8000
VITE_API_TIMEOUT=30000
VITE_WS_PORT=8000

# Feature Flags
VITE_ENABLE_MAPS=true
VITE_ENABLE_REAL_TIME_UPDATES=true
