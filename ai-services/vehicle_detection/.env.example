# AI Service configuration
DJANGO_API_URL=http://localhost:8000
AI_SERVICE_USERNAME=ai_service
AI_SERVICE_PASSWORD=your-ai-service-password-here

# Camera to process (Django Camera model PK)
CAMERA_ID=1

# RTSP stream URL — may be overridden from Django API
# If not set, the service fetches it from GET /api/v1/cameras/{CAMERA_ID}/
RTSP_URL=

# Detection settings
YOLO_MODEL=yolov8n.pt
DETECTION_CONFIDENCE=0.4
MEASUREMENT_INTERVAL_SECONDS=30
MAX_RECONNECT_ATTEMPTS=10
RECONNECT_DELAY_SECONDS=5

# Speed estimation (null = disabled until camera is calibrated)
SPEED_ESTIMATION_ENABLED=false
METERS_PER_PIXEL=

# Violation detection rules
SPEED_LIMIT_KMH=60
VIOLATION_DETECTION_ENABLED=true
