# Django Settings
# Generate a strong key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Must be at least 50 characters for production use with HS256 JWT signing.
SECRET_KEY=your-secret-key-here-replace-with-50-plus-char-random-string
DJANGO_SETTINGS_MODULE=config.settings.development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=traffic_management
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# AI Services
AI_VEHICLE_DETECTION_URL=http://ai-services:8001
AI_TRACKING_URL=http://ai-services:8002
AI_OCR_URL=http://ai-services:8003
AI_FACE_RECOGNITION_URL=http://ai-services:8004
AI_PREDICTION_URL=http://ai-services:8005
